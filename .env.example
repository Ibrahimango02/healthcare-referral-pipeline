# Copy to .env and `export $(cat .env | xargs)` before running the worker.
TEMPORAL_ADDRESS=localhost:7233
# Leave unset to use the offline keyword extractor instead of Claude.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# Leave unset to write FHIR bundles to ./out/ instead of a server.
FHIR_BASE_URL=http://localhost:8080/fhir
# local | lambda
VALIDATION_BACKEND=local
VALIDATION_LAMBDA_NAME=referral-intake-validate
